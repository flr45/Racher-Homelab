[Unit]
Description=Racher OS health monitor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=racher
Group=racher
WorkingDirectory=/home/racher/Racher-Homelab
Environment=ENV_FILE=/home/racher/Racher-Homelab/.env
ExecStart=/usr/bin/python3 /home/racher/Racher-Homelab/scripts/health-monitor.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
