# Long-lived server master secret. Never embed this in the Windows installer.
# Generate with: openssl rand -hex 32
SBR_SYSTEM_LINK_MASTER_SECRET=replace-with-a-long-random-master-secret

# One-time bootstrap token for one installer/PC. Rotate after it has been used.
# Generate with: openssl rand -hex 24
SBR_SYSTEM_LINK_PROVISION_TOKEN=replace-with-a-one-time-provision-token

# Public HTTPS alarm endpoint exposed through Cloudflare Tunnel.
SBR_SYSTEM_LINK_PUBLIC_ENDPOINT=https://link.example.dk/api/system-link

# Optional legacy shared key for older clients during migration. Leave empty for new installs.
SBR_SYSTEM_LINK_SECRET=

# Only bound to 127.0.0.1 on the Pi host. Cloudflare Tunnel should use
# http://sbr-system-link:8098 on the shared Docker proxy network.
SBR_SYSTEM_LINK_PORT=8098
