# Keep USB as the active source until a physical Cudy alarm test has passed.
SMS_MODEM_DRIVER=usb
SMS_MODEM_HOST_DEVICE=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
SMS_MODEM_BAUDRATE=115200
SMS_DRY_RUN=false

# Stock Cudy LT300 web interface; no router firmware replacement is required.
# Set these in /opt/SBR-Pager-Gateway/.env. Do not commit real credentials.
CUDY_BASE_URL=http://192.168.10.1
CUDY_USERNAME=admin
CUDY_PASSWORD=
CUDY_HTTP_TIMEOUT_SECONDS=15
CUDY_POLL_SECONDS=5
# Udgående SMS er fail-closed og kræver både denne flag og SMS_DRY_RUN=false.
CUDY_SMS_SEND_ENABLED=false

# Existing tokens and settings in the root .env are reused by both drivers.
SMS_GATEWAY_API_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
SMS_WHATSAPP_INGEST_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
VAGTBYTTE_FORWARD_ENABLED=false