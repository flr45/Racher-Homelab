# SMS → WhatsApp Gateway
SMS_WHATSAPP_PORT=8091
SMS_WHATSAPP_SMS_GATEWAY_URL=http://sms-gateway:8080
# Genbrug samme værdi som SMS_GATEWAY_API_TOKEN i ~/Racher-Homelab/.env
SMS_GATEWAY_API_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET

# Internt token mellem poller og webdelen
SMS_WHATSAPP_INGEST_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
SMS_WHATSAPP_POLL_SECONDS=2
SMS_WHATSAPP_IGNORE_COMMANDS=status,server status,serverstatus

# Admin-login
SMS_WHATSAPP_ADMIN_USERNAME=admin
SMS_WHATSAPP_ADMIN_PASSWORD=CHANGE_ME
SMS_WHATSAPP_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
SMS_WHATSAPP_COOKIE_SECURE=false

# OpenWA
SMS_WHATSAPP_OPENWA_URL=http://racher-pager-openwa:2785/api
SMS_WHATSAPP_OPENWA_API_KEY=CHANGE_ME
# Brug OpenWA-sessionens id/UUID, ikke kun visningsnavnet.
SMS_WHATSAPP_OPENWA_SESSION_ID=CHANGE_ME

# Leveringssikkerhed
# Fejlede OpenWA-leveringer gemmes i SQLite og forsøges igen efter genstart.
SMS_WHATSAPP_RETRY_ENABLED=true
SMS_WHATSAPP_RETRY_WORKER=true
SMS_WHATSAPP_RETRY_BASE_SECONDS=15
SMS_WHATSAPP_RETRY_MAX_SECONDS=300
SMS_WHATSAPP_RETRY_MAX_ATTEMPTS=20
SMS_WHATSAPP_RETRY_MAX_AGE_HOURS=24
SMS_WHATSAPP_RETRY_POLL_SECONDS=5

# Kvalitetsfilter / Sending 2-kobling
# Filteret stopper kun tydelig transport-/dekoderstøj og kan slås fra ved fejlsøgning.
SMS_WHATSAPP_QUALITY_FILTER_ENABLED=true
# Hvor længe modemlaget må genbruge den seneste primære alarm som parent til en eksplicit Sending 2.
SMS_WHATSAPP_PARENT_MAX_AGE_SECONDS=7200
# Efter en alarm med stationskode kobles beskeder fra samme afsender uden ny stationskode
# automatisk på samme hændelse i dette antal sekunder.
SMS_WHATSAPP_FOLLOWUP_WINDOW_SECONDS=60
