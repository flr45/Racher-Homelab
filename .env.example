TZ=Europe/Copenhagen

# Nginx Proxy Manager database
NPM_DB_NAME=npm
NPM_DB_USER=npm
NPM_DB_PASSWORD=CHANGE_ME
NPM_DB_ROOT_PASSWORD=CHANGE_ME

# PostgreSQL shared service
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME

# Optional app image overrides
MINUTREGNSKAB_IMAGE=ghcr.io/flr45/minutregnskab:latest
VAGTBYTTE_IMAGE=ghcr.io/flr45/vagtbytte:latest

# Vagtbytte
VAGTBYTTE_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
VAGTBYTTE_VAPID_PUBLIC_KEY=CHANGE_ME
VAGTBYTTE_VAPID_PRIVATE_KEY=CHANGE_ME
VAGTBYTTE_VAPID_SUBJECT=mailto:frederik@racher.dk
VAGTBYTTE_DISABLE_PUSH=false

# Kun til første oprettelse. Fjern værdierne fra den lokale .env bagefter.
VAGTBYTTE_BOOTSTRAP_ADMIN_USERNAME=admin
VAGTBYTTE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
VAGTBYTTE_BOOTSTRAP_VC_USERNAME=vc
VAGTBYTTE_BOOTSTRAP_VC_PASSWORD=CHANGE_ME
