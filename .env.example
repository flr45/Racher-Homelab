TZ=Europe/Copenhagen

# Docker runtime
# Installeren erstatter denne værdi med gruppe-ID'et fra /var/run/docker.sock.
DOCKER_GID=999

# Nginx Proxy Manager database
NPM_DB_NAME=npm
NPM_DB_USER=npm
NPM_DB_PASSWORD=CHANGE_ME
NPM_DB_ROOT_PASSWORD=CHANGE_ME

# PostgreSQL shared service
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME

# Backup
BACKUP_ROOT=/home/pi/homelab/backups
BACKUP_RETENTION_DAYS=14
# Valgfri ekstern disk eller netværksmappe. Lad stå tom, indtil den er monteret.
BACKUP_MIRROR_DIR=

# Optional app image overrides
MINUTREGNSKAB_IMAGE=ghcr.io/flr45/minutregnskab:latest
VAGTBYTTE_IMAGE=ghcr.io/flr45/vagtbytte:latest
INDSATSBRIEF_IMAGE=ghcr.io/flr45/indsatsbrief-api:latest
CONTROL_CENTER_IMAGE=ghcr.io/flr45/racher-homelab/control-center:latest

# Watchtower - standard er hver nat kl. 04:00
WATCHTOWER_SCHEDULE=0 0 4 * * *
WATCHTOWER_NOTIFICATIONS_LEVEL=info
# Valgfri Shoutrrr-URL, fx Discord, Gotify eller SMTP. Lad stå tom uden notifikationer.
WATCHTOWER_NOTIFICATION_URL=

# Control Center-links
CONTROL_CENTER_VAGTBYTTE_URL=https://sbr-portal.racher.dk
CONTROL_CENTER_INDSATSBRIEF_URL=https://indsatsbrief.racher.dk
CONTROL_CENTER_MINUTREGNSKAB_URL=https://minutregnskab.racher.dk
CONTROL_CENTER_PORTAINER_URL=https://DIT-LOKALE-NAVN:9443
CONTROL_CENTER_UPTIME_KUMA_URL=https://status.racher.dk
CONTROL_CENTER_NPM_URL=http://DIT-LOKALE-NAVN:81

# Control Center-identitet og App Center-handlinger
# Handlinger er fail-closed og bør først aktiveres, når en betroet identitetsproxy sender
# Cf-Access-Authenticated-User-Email. Kommaadskil flere adresser.
APP_ACTIONS_ENABLED=false
RBAC_ADMIN_EMAILS=
RBAC_OPERATOR_EMAILS=
RBAC_VIEWER_EMAILS=
RBAC_DEFAULT_ROLE=anonymous
# Legacy admin-liste til eksisterende dashboardhandlinger.
ALLOWED_ADMIN_EMAILS=

# Vagtbytte / SBR Portal
VAGTBYTTE_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
VAGTBYTTE_APP_BASE_URL=https://sbr-portal.racher.dk
VAGTBYTTE_VAPID_PUBLIC_KEY=CHANGE_ME
VAGTBYTTE_VAPID_PRIVATE_KEY=CHANGE_ME
VAGTBYTTE_VAPID_SUBJECT=mailto:frederik@racher.dk
VAGTBYTTE_DISABLE_PUSH=false
VAGTBYTTE_ALARM_FEED_INGEST_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
# Intern Docker-adresse fra SMS-gatewayen til Vagtbytte.
VAGTBYTTE_ALARM_FEED_URL=http://vagtbytte-web:3000/api/alarm-feed/ingest

# Vagtbytte-backup
# Automatisk backup køres dagligt, når det angivne klokkeslæt er passeret.
VAGTBYTTE_BACKUP_AUTO_HOUR=3
VAGTBYTTE_BACKUP_RETENTION_COUNT=30
VAGTBYTTE_BACKUP_MONITOR_INTERVAL_MS=300000
# Nøglen skal være 32 tilfældige bytes i base64 og opbevares i en fil med chmod 600.
# Standardplaceringen er secrets/vagtbytte-backup.key i Homelab-mappen.
# Angiv kun en absolut sti her, når standardplaceringen ikke bruges.
VAGTBYTTE_BACKUP_ENCRYPTION_KEY_FILE=

# SBR Portal-mail
# SMTP bruges både til mailrapporter og nulstilling af glemte adgangskoder.
VAGTBYTTE_SMTP_HOST=
VAGTBYTTE_SMTP_PORT=587
VAGTBYTTE_SMTP_SECURE=false
VAGTBYTTE_SMTP_STARTTLS=true
VAGTBYTTE_SMTP_ALLOW_SELF_SIGNED=false
VAGTBYTTE_SMTP_USER=
VAGTBYTTE_SMTP_PASSWORD=
VAGTBYTTE_SMTP_FROM="SBR Portal <no-reply@racher.dk>"
VAGTBYTTE_SMTP_FROM_NAME="SBR Portal"
VAGTBYTTE_SMTP_HELO_NAME=sbr-portal.racher.dk
VAGTBYTTE_EMAIL_REPORT_MONITOR_INTERVAL_MS=60000

# Racher OS-driftsalarm
# Mailen bruger Vagtbyttes SMTP-indstillinger ovenfor.
RACHER_MONITOR_EMAIL_TO=info@racher.dk
RACHER_MONITOR_SMS_TO=
RACHER_MONITOR_REPEAT_HOURS=6
RACHER_MONITOR_DISK_PERCENT=85
RACHER_MONITOR_BACKUP_MAX_HOURS=30
RACHER_MONITOR_TEMP_C=80
RACHER_MONITOR_CONTAINERS=nginx-proxy-manager,control-center,portainer,uptime-kuma,npm-db,postgres,redis,vagtbytte-web,vagtbytte-worker,racher-sms-gateway,minutregnskab,cloudflared

# Status og overvågning af mini-PC
# RACHER_MONITOR_SMS_TO er automatisk godkendt til SMS-kommandoen "status".
# Tilføj evt. flere godkendte numre kommasepareret her.
SMS_COMMAND_ALLOWED_NUMBERS=
SMS_STATUS_POLL_SECONDS=2
RACHER_REMOTE_HOST=racher@racherserver.local
RACHER_REMOTE_SSH_KEY=/home/racher/.ssh/racherserver_monitor_ed25519
RACHER_REMOTE_STATUS_SCRIPT=/home/racher/Racher-Homelab/scripts/host-status.py
RACHER_REMOTE_FAIL_THRESHOLD=3
RACHER_REMOTE_REPEAT_HOURS=6
RACHER_STATUS_DISK_PERCENT=85
RACHER_STATUS_MEMORY_PERCENT=95
RACHER_STATUS_TEMP_C=80

# Kun til første oprettelse. Fjern værdierne fra den lokale .env bagefter.
VAGTBYTTE_BOOTSTRAP_ADMIN_USERNAME=admin
VAGTBYTTE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
VAGTBYTTE_BOOTSTRAP_VC_USERNAME=vc
VAGTBYTTE_BOOTSTRAP_VC_PASSWORD=CHANGE_ME

# Indsatsbrief
INDSATSBRIEF_FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
INDSATSBRIEF_ACCESS_CODE=CHANGE_ME
INDSATSBRIEF_OPENAI_API_KEY=CHANGE_ME
INDSATSBRIEF_OPENAI_MODEL=gpt-5.4-mini
INDSATSBRIEF_ADMIN_APPROVAL_REQUIRED=true
INDSATSBRIEF_ADMIN_EMAIL=frederik@racher.dk
INDSATSBRIEF_ADMIN_NOTIFY_EMAIL=frederik@racher.dk
INDSATSBRIEF_CONTACT_EMAIL=frederik@racher.dk
INDSATSBRIEF_APP_BASE_URL=https://indsatsbrief.racher.dk
INDSATSBRIEF_SHOW_CODE_LOGIN=false

# Valgfri mailopsætning til Indsatsbrief
INDSATSBRIEF_SMTP_HOST=
INDSATSBRIEF_SMTP_PORT=587
INDSATSBRIEF_SMTP_USERNAME=
INDSATSBRIEF_SMTP_PASSWORD=
INDSATSBRIEF_SMTP_FROM=
INDSATSBRIEF_SMTP_USE_TLS=true
