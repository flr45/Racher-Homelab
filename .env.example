TZ=Europe/Copenhagen

# Nginx Proxy Manager database
NPM_DB_NAME=npm
NPM_DB_USER=npm
NPM_DB_PASSWORD=CHANGE_ME
NPM_DB_ROOT_PASSWORD=CHANGE_ME

# PostgreSQL shared service
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME

# Optional app image overrides
MINUTREGNSKAB_IMAGE=ghcr.io/flr45/minutregnskab:latest
VAGTBYTTE_IMAGE=ghcr.io/flr45/vagtbytte:latest
INDSATSBRIEF_IMAGE=ghcr.io/flr45/indsatsbrief-api:latest

# Watchtower - standard er hver nat kl. 04:00
WATCHTOWER_SCHEDULE=0 0 4 * * *
WATCHTOWER_NOTIFICATIONS_LEVEL=info
# Valgfri Shoutrrr-URL, fx Discord, Gotify eller SMTP. Lad stå tom uden notifikationer.
WATCHTOWER_NOTIFICATION_URL=

# Vagtbytte
VAGTBYTTE_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
VAGTBYTTE_VAPID_PUBLIC_KEY=CHANGE_ME
VAGTBYTTE_VAPID_PRIVATE_KEY=CHANGE_ME
VAGTBYTTE_VAPID_SUBJECT=mailto:frederik@racher.dk
VAGTBYTTE_DISABLE_PUSH=false

# Kun til første oprettelse. Fjern værdierne fra den lokale .env bagefter.
VAGTBYTTE_BOOTSTRAP_ADMIN_USERNAME=admin
VAGTBYTTE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
VAGTBYTTE_BOOTSTRAP_VC_USERNAME=vc
VAGTBYTTE_BOOTSTRAP_VC_PASSWORD=CHANGE_ME

# Indsatsbrief
INDSATSBRIEF_FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
INDSATSBRIEF_ACCESS_CODE=CHANGE_ME
INDSATSBRIEF_OPENAI_API_KEY=CHANGE_ME
INDSATSBRIEF_OPENAI_MODEL=gpt-5.4-mini
INDSATSBRIEF_ADMIN_APPROVAL_REQUIRED=true
INDSATSBRIEF_ADMIN_EMAIL=frederik@racher.dk
INDSATSBRIEF_ADMIN_NOTIFY_EMAIL=frederik@racher.dk
INDSATSBRIEF_CONTACT_EMAIL=frederik@racher.dk
INDSATSBRIEF_APP_BASE_URL=https://indsatsbrief.racher.dk
INDSATSBRIEF_SHOW_CODE_LOGIN=false

# Valgfri mailopsætning til Indsatsbrief
INDSATSBRIEF_SMTP_HOST=
INDSATSBRIEF_SMTP_PORT=587
INDSATSBRIEF_SMTP_USERNAME=
INDSATSBRIEF_SMTP_PASSWORD=
INDSATSBRIEF_SMTP_FROM=
INDSATSBRIEF_SMTP_USE_TLS=true
