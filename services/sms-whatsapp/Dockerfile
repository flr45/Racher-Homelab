FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py events_app.py stats_v2.py station_filter_app.py admin_station_app.py ui_app.py history_app.py station_names_app.py geocode_app.py delivery_retry_app.py poller.py ./
RUN python -m py_compile app.py events_app.py stats_v2.py station_filter_app.py admin_station_app.py ui_app.py history_app.py station_names_app.py geocode_app.py delivery_retry_app.py poller.py
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-events-build.db SMS_WHATSAPP_INGEST_TOKEN=build-token python -c 'from events_app import app,db,base,AlarmEvent; ctx=app.app_context(); ctx.push(); db.create_all(); db.session.add(base.AllowedSender(name="test",phone="+4512345678",active=True)); db.session.commit(); c=app.test_client(); h={"Authorization":"Bearer build-token"}; p={"sender":"+4512345678","body":"🚨 ALARM MODTAGET\n(S)M+V · Bygn.brand-Villa/Rækkehus","rawBody":"(S)M+V · Bygn.brand-Villa/Rækkehus","receivedAt":"2026-09-13T07:00:00Z","sourceMessageId":"pre-1","eventKey":"event-1","groupKey":"event-1","messageKind":"alarm_prealert","partCurrent":1,"partTotal":2}; r=c.post("/api/incoming",json=p,headers=h); assert r.status_code==201; p.update(body="🚨 KOMPLET ALARM\n(S)M+V · Bygn.brand-Villa/Rækkehus · Testvej 12, 4200 Slagelse",rawBody="(S)M+V · Bygn.brand-Villa/Rækkehus · Testvej 12, 4200 Slagelse",sourceMessageId="complete-1",messageKind="alarm_complete",partCurrent=2); r=c.post("/api/incoming",json=p,headers=h); assert r.status_code==201; e=AlarmEvent.query.one(); assert e.status=="complete" and e.station=="S" and e.alarm_type=="Bygn.brand-Villa/Rækkehus"; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-stats-build.db python -c 'import stats_v2; assert stats_v2.app is not None'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-station-filter-build.db python -c 'import station_filter_app as s; ctx=s.app.app_context(); ctx.push(); s.db.create_all(); r=s.base.Recipient(name="R",phone="+4512345678",active=True); s.db.session.add(r); s.db.session.commit(); assert s.recipient_accepts(r.id,"S"); s.db.session.add(s.RecipientStationFilter(recipient_id=r.id,station="S")); s.db.session.commit(); assert s.recipient_accepts(r.id,"S") and not s.recipient_accepts(r.id,"A"); assert s.detect_station("🚨 ALARM\n(S)M+V") == "S"; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-admin-stations-build.db python -c 'import admin_station_app as a; ctx=a.app.app_context(); ctx.push(); a.db.create_all(); r=a.base.Recipient(name="Testbruger",phone="+4511111111",active=True); a.db.session.add(r); a.db.session.commit(); assert a.previous.configured_stations(r.id)=={"*"}; st=a.AdminStation(name="Slagelse"); a.db.session.add(st); a.db.session.commit(); a.db.session.add(a.RecipientAdminStation(recipient_id=r.id,station_id=st.id)); a.db.session.commit(); groups,unassigned=a.station_overview(); assert len(groups)==1 and groups[0]["station"].name=="Slagelse" and groups[0]["recipients"][0].id==r.id and not unassigned; a.previous.RecipientStationFilter.query.filter_by(recipient_id=r.id).delete(); a.db.session.add(a.previous.RecipientStationFilter(recipient_id=r.id,station="S")); a.db.session.commit(); assert a.alarm_filter_map()[r.id]=={"S"}; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-ui-build.db python -c 'import ui_app; assert ui_app.app is not None'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-history-build.db python -c 'import history_app as h; ctx=h.app.app_context(); ctx.push(); h.db.create_all(); e=h.events.AlarmEvent(event_key="map-test",sender="+4512345678",station="S",alarm_type="Test",address="Testvej 1",status="complete",started_at=h.base.utcnow(),last_update_at=h.base.utcnow()); h.db.session.add(e); h.db.session.commit(); h.db.session.add(h.AlarmEventLocation(event_id=e.id,latitude=55.4,longitude=11.35)); h.db.session.commit(); assert h.event_location(e.id) is not None and h.filtered_stats("S")["days30"]==1; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-station-names-build.db python -c 'import station_names_app as s; assert s.station_name("A")=="Slagelse"; assert s.station_name("S")=="Sorø"; assert s.station_name("L")=="Skælskør"; assert s.station_name("R")=="Ruds Vedby"; assert s.station_name("K")=="Korsør"; assert s.station_name("B")=="Storebælt"; assert s.app is not None'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-geocode-build.db SBR_PAGER_AUTO_GEOCODE=false python -c 'import geocode_app as g; a={"kategori":"A","resultater":[{"aktueladresse":{"adgangspunkt":{"koordinater":[11.35,55.4]}}}]}; c={"kategori":"C","resultater":[{"aktueladresse":{"adgangspunkt":{"koordinater":[11.35,55.4]}}}]}; assert g.parse_geocode_result(a)==(55.4,11.35,"A"); assert g.parse_geocode_result(c) is None; assert g.address_candidates("(S)M+V · Brand · Testvej 12, 4200 Slagelse")[0]=="Testvej 12, 4200 Slagelse"; assert g.app is not None'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-retry-build.db SMS_WHATSAPP_RETRY_WORKER=false SBR_PAGER_AUTO_GEOCODE=false python -c 'import delivery_retry_app as r; ctx=r.app.app_context(); ctx.push(); r.db.create_all(); sender=r.base.AllowedSender(name="test",phone="+4512345678",active=True); recipient=r.base.Recipient(name="R",phone="+4522222222",active=True); r.db.session.add_all([sender,recipient]); r.db.session.commit(); inbound=r.base.InboundMessage(source_id="retry-test",sender=sender.phone,body="(S)M+V · Testalarm",received_at=r.base.utcnow(),accepted=True); r.db.session.add(inbound); r.db.session.commit(); original=r.base.send_whatsapp; r.base.send_whatsapp=lambda phone,body: (_ for _ in ()).throw(RuntimeError("OpenWA offline")); sent,queued=r.deliver_inbound_resilient(inbound); delivery=r.base.WhatsAppDelivery.query.one(); state=r.WhatsAppRetryState.query.one(); assert sent==0 and queued==1 and delivery.status=="retrying" and state.attempts==1; state.next_attempt_at=r.base.utcnow(); r.db.session.commit(); r.base.send_whatsapp=lambda phone,body: "wa-ok"; result=r.retry_due_once(); r.db.session.refresh(delivery); assert result["sent"]==1 and delivery.status=="sent" and delivery.message_id=="wa-ok"; r.base.send_whatsapp=original; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-parent-build.db SMS_WHATSAPP_INGEST_TOKEN=build-token python -c 'import events_app as e; ctx=e.app.app_context(); ctx.push(); e.db.create_all(); e.db.session.add(e.base.AllowedSender(name="test",phone="+4512345678",active=True)); e.db.session.commit(); c=e.app.test_client(); h={"Authorization":"Bearer build-token"}; common={"sender":"+4512345678","receivedAt":"2026-09-19T07:00:00Z"}; p=dict(common,body="(S)M+V · Brand 1",rawBody="(S)M+V · Brand 1",sourceMessageId="p1",eventKey="event-1",groupKey="event-1",messageKind="alarm_complete"); assert c.post("/api/incoming",json=p,headers=h).status_code==201; p=dict(common,body="(A)M+V · Brand 2",rawBody="(A)M+V · Brand 2",sourceMessageId="p2",eventKey="event-2",groupKey="event-2",messageKind="alarm_complete",receivedAt="2026-09-19T07:01:00Z"); assert c.post("/api/incoming",json=p,headers=h).status_code==201; p=dict(common,body="📟 SENDING 2 · ekstra melding",rawBody="Sending 2 · ekstra melding",sourceMessageId="s2",eventKey="sending-2",groupKey="sending-2",parentEventKey="event-1",messageKind="sending2_complete",receivedAt="2026-09-19T07:02:00Z"); assert c.post("/api/incoming",json=p,headers=h).status_code==201; one=e.AlarmEvent.query.filter_by(event_key="event-1").one(); two=e.AlarmEvent.query.filter_by(event_key="event-2").one(); assert one.followup_count==1 and two.followup_count==0; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-quality-build.db SMS_WHATSAPP_RETRY_WORKER=false SBR_PAGER_AUTO_GEOCODE=false python -c 'import delivery_retry_app as r; ctx=r.app.app_context(); ctx.push(); r.db.create_all(); s=r.base.AllowedSender(name="test",phone="+4512345678",active=True); q=r.base.Recipient(name="R",phone="+4522222222",active=True); r.db.session.add_all([s,q]); r.db.session.commit(); bad=r.base.InboundMessage(source_id="noise",sender=s.phone,body=chr(0)+"@@@@@@@@@@@@",received_at=r.base.utcnow(),accepted=True); r.db.session.add(bad); r.db.session.commit(); assert r.deliver_inbound_resilient(bad)==(0,0); r.db.session.refresh(bad); assert bad.accepted is False and r.InboundDecision.query.filter_by(inbound_id=bad.id,decision="ignored_noise").one(); assert r.message_quality("(S)M+V · Bygn.brand · Testvej 1, 4200 Slagelse")[0] is True; assert r.base.WhatsAppDelivery.query.count()==0; ctx.pop()'
RUN DATABASE_URL=sqlite:////tmp/sms-whatsapp-parent-routing-build.db python -c 'import station_filter_app as s; ctx=s.app.app_context(); ctx.push(); s.db.create_all(); now=s.base.utcnow(); one=s.events.AlarmEvent(event_key="parent-s",sender="+4512345678",station="S",status="complete",started_at=now,last_update_at=now); two=s.events.AlarmEvent(event_key="newer-a",sender="+4512345678",station="A",status="complete",started_at=now,last_update_at=now); inbound=s.base.InboundMessage(source_id="s2-route",sender="+4512345678",body="Sending 2 · ekstra",received_at=now,accepted=True); s.db.session.add_all([one,two,inbound]); s.db.session.commit(); req=s.app.test_request_context("/api/incoming",method="POST",json={"parentEventKey":"parent-s"}); req.push(); assert s.station_for_inbound(inbound)=="S"; req.pop(); ctx.pop()'
RUN mkdir -p /data && chown -R appuser:appuser /app /data
USER appuser
EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "60", "delivery_retry_app:app"]